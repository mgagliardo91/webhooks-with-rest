#!/bin/sh
# Usage: script/server
# Starts a server for development purposes inside a docker container.

# Set the RAILS_ENV if not currently set
: ${RAILS_ENV:=development}
export RAILS_ENV

docker rm -f proxy changelogger >/dev/null 2>&1 || true
rm -f changelogger/tmp/pids/server.pid

APP_CONTAINER=$(docker run --rm -d \
    -p 3000 \
    -e DISABLE_SPRING=true \
    --name changelogger \
    --mount type=bind,source="$(pwd)"/changelogger,target=/data/apps/changelogger \
    changelogger:latest)

docker run --rm -d \
    -p 4040:4040 \
    -e NGROK_AUTHTOKEN \
    --name proxy \
    --link changelogger:http \
    ngrok/ngrok http http:3000 >/dev/null

TUNNELS_DATA=
PUBLIC_URL=
attempt=0
while [ "$attempt" -lt 15 ]; do
    TUNNELS_DATA=$(curl -fsS http://localhost:4040/api/tunnels 2>/dev/null || true)
    PUBLIC_URL=$(printf '%s' "$TUNNELS_DATA" |
        grep -o '"public_url":"https:[^"]*"' |
        head -n 1 |
        cut -d '"' -f 4)
    [ -n "$PUBLIC_URL" ] && break
    attempt=$((attempt + 1))
    sleep 1
done

if [ -z "$PUBLIC_URL" ]; then
    echo "The ngrok proxy started, but no public tunnel became available." >&2
    exit 1
fi

cat logo.txt
echo ""

bold=$(tput bold)
normal=$(tput sgr0)

echo "+----------------------------------------------+"
echo "| Your public url is: ${bold}$PUBLIC_URL${normal} |"
echo "+----------------------------------------------+"
echo ""
echo "This is the output of your web app."
echo "==================================="
echo ""
docker attach "$APP_CONTAINER"
